rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Core auth helpers ────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // isAdmin() checks two sources, in order:
    //
    //  1. Custom claim on the Firebase Auth token (set by your backend /
    //     Cloud Function). Zero Firestore reads — fastest path.
    //
    //  2. A UID-keyed document in `admins`. Covers accounts provisioned by the
    //     admin management UI (which writes the doc at admins/{uid}).
    //
    // NOTE: Legacy admin documents created with addDoc() have a *random* doc
    // ID and the Auth UID only lives in a `uid` FIELD. Those accounts are
    // handled by the special `allow list` rule on /admins below, which lets
    // the app's where("uid","==",uid) query succeed. They cannot be detected
    // here via exists() because the document ID is unknown — the app-layer
    // findUserInCollections() resolves them, and once resolved the session
    // carries the correct role for all subsequent requests.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isDoctor() {
      return isAuthenticated() && (
        request.auth.token.role == 'doctor' ||
        exists(/databases/$(database)/documents/doctors/$(request.auth.uid))
      );
    }

    // isStaff() — matches either doctors or admins. Used wherever either role
    // should have the same access (e.g. reading patient records for care).
    function isStaff() {
      return isDoctor() || isAdmin();
    }

    // ── Patients ─────────────────────────────────────────────────────────────
    //
    //  - Authenticated users can create their own profile.
    //  - Patients can read/update their own document.
    //  - Doctors and Admins can read/update patient profiles for care.
    //  - Owners can delete their own profile (self-service account deletion);
    //    admins can delete any patient record.
    match /patients/{patientId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(patientId) || isAdmin();
      allow update: if isOwner(patientId) || isStaff();
      allow delete: if isOwner(patientId) || isAdmin();

      // Subcollections the patient app writes under the profile document
      // (medications tracker, family members). Owner + staff can manage them;
      // owner delete is required for account erasure.
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(patientId) || isStaff();
        allow delete: if isOwner(patientId) || isAdmin();
      }
    }

    // ── Doctors ──────────────────────────────────────────────────────────────
    //
    //  - Any authenticated user can browse verified doctor profiles.
    //  - Doctors manage their own profile; admins manage all.
    //  - Owners can delete their own profile (self-service account deletion);
    //    admins can verify, enable/disable, or delete doctor accounts.
    match /doctors/{doctorId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(doctorId) || isAdmin();
      allow update: if isOwner(doctorId) || isAdmin();
      allow delete: if isOwner(doctorId) || isAdmin();
    }

    // ── Admins ───────────────────────────────────────────────────────────────
    //
    // Two document shapes exist in this collection:
    //
    //  • Modern  — document ID == Auth UID (written by current signup flow).
    //  • Legacy  — document ID is a random auto-ID; Auth UID is in a `uid`
    //              FIELD (written by old addDoc() calls).
    //
    // Sign-in flow for admins using the Doctor portal (DoctorSignin):
    //  1. Firebase Auth succeeds with email/password.
    //  2. App calls findUserInCollections(uid):
    //     a. getDoc(admins/{uid})  → hits modern docs.
    //     b. getDocs(where("uid","==",uid)) → hits legacy docs.
    //        This query is validated by the `allow list` rule below, which
    //        Firestore can prove because every doc returned satisfies
    //        resource.data.uid == request.auth.uid.
    //  3. resolveRole() returns UserRole.Admin (collection name wins).
    //  4. assertRoleAccess([Doctor, Admin]) passes.
    //  5. App routes to /admin/dashboard.
    //
    // Read access breakdown:
    //  • get  (single-doc): isAdmin() or own UID-keyed doc, or legacy field match.
    //  • list (collection query): isAdmin() or query filtered to own uid field.
    //
    // Write access: only existing admins can create / update / delete.
    match /admins/{adminId} {
      allow get: if isAdmin() ||
        (isAuthenticated() && (
          adminId == request.auth.uid ||
          resource.data.uid == request.auth.uid
        ));

      // The list rule must allow the legacy uid-field query:
      //   getDocs(collection("admins"), where("uid","==",uid))
      // Firestore rules can verify that every document the query could return
      // satisfies resource.data.uid == request.auth.uid, so this is safe —
      // a user can only ever retrieve their own record this way.
      allow list: if isAdmin() ||
        (isAuthenticated() && resource.data.uid == request.auth.uid);

      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Appointments ─────────────────────────────────────────────────────────
    //
    //  - Patients and doctors involved in the appointment can read/update.
    //  - Patients create bookings; admins manage all.
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        resource.data.doctorUserId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        resource.data.doctorUserId == request.auth.uid
      );
      // Patients and doctors may erase their own bookings when deleting their
      // account; admins retain full delete for moderation.
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        resource.data.doctorUserId == request.auth.uid
      );
    }

    // ── Diagnoses & Prescriptions ────────────────────────────────────────────
    //
    //  Sensitive medical data: patients read their own; doctors create/update
    //  for their patients; admins have clinical oversight.
    match /diagnoses/{diagnosisId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid
      );
      allow create: if isAuthenticated() && isStaff();
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.doctorId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // ── Notifications ────────────────────────────────────────────────────────
    //
    //  Users read/update/delete their own; any authenticated user (or Cloud
    //  Function running as an authenticated principal) can create one.
    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && (
        resource.data.recipientId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
    }

    // ── Consultations & Messages (real-time chat) ────────────────────────────
    match /consultations/{consultationId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /messages/{messageId} {
      allow read, write: if isAuthenticated();
    }

    // ── Medications tracker ──────────────────────────────────────────────────
    match /medications/{medicationId} {
      allow read, write: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        request.resource.data.patientId == request.auth.uid ||
        isStaff()
      );
    }

    // ── Patient Vitals ───────────────────────────────────────────────────────
    match /vitals/{vitalId} {
      allow read, write: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        request.resource.data.patientId == request.auth.uid ||
        isStaff()
      );
    }

    // ── Call logs ────────────────────────────────────────────────────────────
    match /callLogs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // ── Health units directory ───────────────────────────────────────────────
    match /health_units/{unitId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Articles / Health Education ──────────────────────────────────────────
    //
    //  Public read so unauthenticated users can browse health tips; write is
    //  restricted to staff (doctors publish articles, admins moderate).
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ── FCM tokens ───────────────────────────────────────────────────────────
    match /fcmTokens/{tokenId} {
      allow read, write: if isAuthenticated();
    }

    // ── User Locations (real-time location sharing) ──────────────────────────
    //
    // Privacy model:
    //  - A user writes only their own document (uid == document id).
    //  - Authenticated users can read locations where isSharing == true
    //    (patients see nearby doctors, doctors see patients, admin sees all).
    //  - Admins can read any location regardless of isSharing.
    //  - A location with isSharing == false is invisible unless the reader is
    //    the owner or an admin.
    //  - Users can delete their own document (GDPR right-to-erasure).
    //
    // Write validation (prevents spoofing):
    //  - uid field must match the authenticated UID.
    //  - isSharing must be a boolean.
    //  - lat/lng must be numbers within valid geographic bounds.
    match /userLocations/{userId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        request.auth.uid == userId ||
        resource.data.isSharing == true
      );
      allow create, update: if isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.isSharing is bool &&
        request.resource.data.lat is number &&
        request.resource.data.lng is number &&
        request.resource.data.lat >= -90 &&
        request.resource.data.lat <= 90 &&
        request.resource.data.lng >= -180 &&
        request.resource.data.lng <= 180;
      allow delete: if isAuthenticated() && (
        request.auth.uid == userId || isAdmin()
      );
    }
  }
}
