# HomeCare237 Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ── Firebase Configuration ────────────────────────────────────────────────
VITE_REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_REACT_APP_FIREBASE_PROJECT_ID=your_project_id
VITE_REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_REACT_APP_FIREBASE_APP_ID=your_app_id
VITE_REACT_APP_FIREBASE_MEASUREMENT_ID=your_measurement_id
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here

# ── Twilio Configuration ───────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_API_KEY=your_twilio_api_key
TWILIO_API_SECRET=your_twilio_api_secret
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_TWIML_APP_SID=your_twiml_app_sid

# ── Google Gemini AI Configuration ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-1.5-flash

# ── API Configuration ──────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3400
VITE_API_TIMEOUT_MS=20000
VITE_AI_TIMEOUT_MS=20000

# ── Application Configuration ──────────────────────────────────────────────
VITE_APP_NAME=HomeCare237
VITE_APP_VERSION=1.0.0
VITE_LEGACY_BUILD=false
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true

# ── Session Configuration ────────────────────────────────────────────────
VITE_SESSION_TIMEOUT_MINUTES=30
VITE_TOKEN_REFRESH_INTERVAL_MINUTES=15

# ── Feature Flags ─────────────────────────────────────────────────────────
VITE_ENABLE_TELEHEALTH=true
VITE_ENABLE_MOBILE_MONEY=true
VITE_ENABLE_FAMILY_ACCOUNTS=true
VITE_ENABLE_AI_HEALTH_TIPS=true
VITE_ENABLE_BIOMETRIC_AUTH=true

# ── Healthcare Compliance ─────────────────────────────────────────────────
VITE_ENABLE_AUDIT_LOGGING=true
VITE_DATA_RETENTION_DAYS=365
VITE_ENABLE_CONSENT_MANAGEMENT=true

# ── Development Only ───────────────────────────────────────────────────────
NODE_ENV=development
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=info