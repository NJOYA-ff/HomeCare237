<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Location ──────────────────────────────────────────────────────── -->
    <!-- Required by @capacitor/geolocation -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Android 10+ (API 29+): background location for tracking while backgrounded -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- ── Notifications ─────────────────────────────────────────────────── -->
    <!-- Android 13+ (API 33+): must be requested at runtime AND declared here -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required for notification sound + vibration pattern -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Allows the app to reschedule local notifications after device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Required to keep the screen on while a foreground service is active (optional but safe) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Required by FCM on some OEM variants -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Hardware feature hints (not hard requirements) -->
    <uses-feature android:name="android.hardware.location.gps"     android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- ── FCM: default notification appearance ──────────────────────── -->
        <!--
             These meta-data tags tell FCM which resources to use when a DATA
             message arrives and the app is in the background (i.e. when the
             FCM library renders the notification itself, before the app has a
             chance to handle it).

             firebase_messaging_default_notification_icon:
               MUST be a white-on-transparent drawable (NOT a mipmap).
               ic_stat_health is the white health-cross icon from the
               health_status_notification_icons pack, placed in drawable-*
               density buckets.  Android 5+ uses only the alpha channel of
               this image and tints it with the notification_color below,
               so the icon must be purely white on a transparent background.

             firebase_messaging_default_notification_color:
               The accent colour rendered behind/around the icon in the
               notification shade.  Matches the app primary brand colour
               (#2563EB blue).  Defined in res/values/colors.xml.

             firebase_messaging_default_notification_channel_id:
               The channel that FCM uses for background-delivered notifications.
               We create this channel in NotificationService.initialize() so
               the user can configure it per-channel in device Settings.

             NOTE — large icon (full-colour app logo in expanded view):
               The full-colour round launcher icon (@mipmap/ic_launcher_round)
               is set as largeIcon at runtime in NotificationServices.ts.
               It lives in mipmap-* which is correct for launcher/large icons.
               Do NOT put the small status-bar icon in mipmap — it must be
               in drawable-* so Android can apply the alpha-mask tinting.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_health" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />

        <!-- ── Main Activity ─────────────────────────────────────────────── -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:name=".MainActivity"
            android:theme="@style/AppTheme.NoActionBarLaunch">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Required by @codetrix-studio/capacitor-google-auth (and Firebase
                Auth on Android) so the Google Sign-In activity can return its
                result to the app via an intent.

                scheme: must be your reverse-DNS OAuth client ID:
                  the web OAuth client ID reversed →
                  com.googleusercontent.apps.770997904222-upkuve0qgasnfham5q31rc1qoj218vuv
                host: must be "oauth2redirect" (exactly)
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="com.googleusercontent.apps.770997904222-upkuve0qgasnfham5q31rc1qoj218vuv"
                    android:host="oauth2redirect" />
            </intent-filter>

        </activity>

        <!-- ── FileProvider (required by @capacitor/camera etc.) ─────────── -->
        <provider
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true"
            android:name="androidx.core.content.FileProvider">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
